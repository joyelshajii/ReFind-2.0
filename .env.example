# ==============================================================
# ReFind Environment Configuration
# Team: BitByBit
# ==============================================================

# Backend API Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration
# For PostgreSQL with pgvector (recommended for production/docker):
# DATABASE_URL=postgresql://refind_user:refind_password@localhost:5432/refind_db
# If empty or PostgreSQL is not reachable, ReFind automatically uses the zero-config local SQLite + vector fallback:
DATABASE_URL=

# Available options: gemini, local, openai, jina
EMBEDDING_PROVIDER=gemini
LLM_PROVIDER=gemini

# Offline local indexing defaults to the verified cached multimodal model.
# Set LOCAL_FAST_MODE=false to explicitly use the legacy optional remote path.
LOCAL_FAST_MODE=true
LOCAL_EMBEDDING_MODEL_ID=google/embeddinggemma-2
LOCAL_EMBEDDING_MODEL_REVISION=914f7f89142e33e77833254d9c9b90c3cef7303b
LOCAL_EMBEDDING_BATCH_SIZE=8
LOCAL_EMBEDDING_WARMUP=true
INDEX_EMBEDDING_FILE_BATCH_SIZE=4
INDEX_EXTRACTION_WORKERS=2
INDEX_HASH_METADATA_FAST_PATH_SECONDS=60

# Exact vector cache; automatically invalidated when indexed content changes.
SEARCH_VECTOR_CACHE_MB=128
# Generate prose when opening context; search still returns ranking and evidence.
SEARCH_INLINE_EXPLANATIONS=false
SEARCH_SEMANTIC_MIN_SCORE=0.68
RERANK_CACHE_SECONDS=300
RERANK_TIMEOUT_SECONDS=8

# API Keys and Models
GEMINI_API_KEY=
JINA_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_REASONING_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Used only when LOCAL_FAST_MODE=false.
IMAGE_VISION_ENABLED=true
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_RERANKER_MODEL=jina-reranker-v2-base-multilingual

# File Storage
UPLOAD_DIR=./storage/uploads
DEMO_DATA_DIR=./demo_data

